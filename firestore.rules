rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The portal's shared school-state document is available only to
    // authenticated users granted the admin custom claim by a trusted server.
    match /portalData/{document} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Deny all other access unless a future collection gets an explicit rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
